<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Benten.SDK</AssemblyName>
    <RootNamespace>Benten.SDK</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Huzefa Karachiwala</Authors>
    <Description>Client SDK for the Benten Authentication and Authorization Platform. Enables applications to request user approval for login, credit card transactions, IoT setting changes, and generic notifications via push notification.</Description>
    <PackageTags>benten;authentication;authorization;push-notification;websocket</PackageTags>
    <RepositoryUrl>https://github.com/bentenauth/benten-sdk</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package -->
    <PackageId>Benten.SDK</PackageId>
    <Copyright>Copyright © 2026 Benten Technologies</Copyright>
    <PackageProjectUrl>https://bententechnologies.com/sdk.html</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>First release. Authenticate with an API key from the Benten developer dashboard: new BentenClient(apiKey). Request approval for logins, credit card transactions, IoT setting changes and generic notifications.</PackageReleaseNotes>

    <!-- Symbols and Source Link, so developers can step into the SDK when debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Benten.SDK.Tests" />
  </ItemGroup>

</Project>
